{
  "name": "auralink-mcp",
  "version": "0.1.0-alpha.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Local MCP server for Auralink EQ — read state and generate/validate/apply per-headphone EQ tunings.",
  "type": "module",
  "bin": {
    "auralink-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "license:check": "node scripts/check-licenses.mjs",
