# SwiftPM build output
.build/

# Assembled app bundle (scripts/bundle-app.sh)
build/
*.app

# Node / MCP server
node_modules/
dist/
.env
.env.*
!.env.example

# macOS / Xcode cruft
.DS_Store
*.xcuserstate
.swiftpm/

# Signing credentials and distributable archives
*.p12
*.pem
*.key
*.mobileprovision
*.provisionprofile
*.dmg

# Generated planning documents (keep reviewable docs in Markdown)
docs/*.docx

# Headphone profiles and curated presets belong to the user, not to this app.
# They live in a collection repository of their own (see docs/DATA_COLLECTION.md);
# this entry keeps a local checkout or leftover from ever landing back here.
/library/
/auralink-collection/

# Agent tooling (local sessions, subagent artifacts)
.codex/
.pi-subagents/
